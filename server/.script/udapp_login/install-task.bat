@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  install-task.bat  (run on 169)
rem  Remotely register two scheduled tasks on 206:
rem    udapp_login         boot-start, run as admin, log redirected
rem    udapp_login_deploy  manual-only, trigger deploy
rem  Also pushes *.remote.bat to 206 staging dir.
rem  Usage: install-task.bat
rem ============================================================

set "LOCAL=%~dp0"
call "%LOCAL%deploy.local.bat"
if errorlevel 1 ( echo [ERROR] deploy.local.bat not found, copy from deploy.local.example.bat & exit /b 1 )
if "%REMOTE_PWD%"=="在这里填 admin 密码" ( echo [ERROR] edit deploy.local.bat and set REMOTE_PWD & exit /b 1 )

set "STAGING_DIR=%REMOTE_SHARE%\Server\.staging"
rem schtasks /tr path must be a 206 local path, not UNC
set "RUN_BAT=C:\ProgramCustom\Server\udapp_login\run.bat"
set "DEPLOY_BAT=C:\ProgramCustom\Server\.staging\deploy.remote.bat"

echo === install tasks on %REMOTE_HOST% ===
echo RUN_BAT    = %RUN_BAT%
echo DEPLOY_BAT = %DEPLOY_BAT%
if not exist "%RUN_BAT%" echo [WARN] run.bat not yet present, generated by deploy.remote.bat on first deploy.

rem --- 1. push remote scripts to 206 staging ---
echo.
echo [1] push remote scripts to staging
rem check if share already connected (Explorer may have opened it, avoid error 1219)
if not exist "%REMOTE_SHARE%\Server" (
  net use "%REMOTE_SHARE%" "%REMOTE_PWD%" /user:%REMOTE_USER% >nul 2>&1
)
if not exist "%STAGING_DIR%" mkdir "%STAGING_DIR%"
robocopy "%LOCAL%" "%STAGING_DIR%" *.remote.bat /NFL /NDL /NJH /NJS /NC /NS /NP >nul

rem --- 2. delete old tasks ---
echo.
echo [2] delete old tasks if exist
schtasks /delete /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login /f >nul 2>&1
schtasks /delete /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login_deploy /f >nul 2>&1

rem --- 3. create udapp_login ---
echo.
echo [3] create udapp_login  (onstart, as %REMOTE_USER%, highest)
schtasks /create /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login /tr "%RUN_BAT%" /sc onstart /ru "%REMOTE_USER%" /rp "%REMOTE_PWD%" /rl highest /f
if errorlevel 1 ( echo [ERROR] create udapp_login failed & exit /b 1 )

rem --- 4. create udapp_login_deploy ---
echo.
echo [4] create udapp_login_deploy  (manual only, as %REMOTE_USER%, highest)
schtasks /create /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login_deploy /tr "%DEPLOY_BAT%" /sc once /sd 01/01/2020 /st 00:00 /ru "%REMOTE_USER%" /rp "%REMOTE_PWD%" /rl highest /f
if errorlevel 1 ( echo [ERROR] create udapp_login_deploy failed & exit /b 1 )

echo.
echo [OK] tasks created on %REMOTE_HOST%.
echo   schtasks /run /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login          -- start service
echo   schtasks /end /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login          -- stop service
echo   schtasks /run /s %REMOTE_HOST% /u %REMOTE_USER% /p %REMOTE_PWD% /tn udapp_login_deploy   -- trigger deploy
endlocal
exit /b 0
