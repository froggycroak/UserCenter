@echo off
chcp 65001 >nul
setlocal EnableExtensions

rem node_modules entity outside repo; web\node_modules is a Junction.
rem Real: C:\ProgramCustom\LibCustom\NodeModules\user-center.web\node_modules
rem Link: <repo>\web\node_modules -> that real directory
rem
rem Do NOT npm install against the Junction on Windows (npm reify may replace it).
rem Install in NM_PARENT with copied package.json/lock, then re-link.

set "FRONT=%~dp0"
if "%FRONT:~-1%"=="\" set "FRONT=%FRONT:~0,-1%"

set "NM_PARENT=C:\ProgramCustom\LibCustom\NodeModules\user-center.web"
set "NM_REAL=%NM_PARENT%\node_modules"
set "NM_LINK=%FRONT%\node_modules"

echo === ensure_node_modules (user-center.web) ===
echo NM_REAL=%NM_REAL%
echo NM_LINK=%NM_LINK%

where npm >nul 2>&1
if errorlevel 1 (
  echo [ERROR] npm not found in PATH
  exit /b 1
)

if not exist "C:\ProgramCustom\LibCustom\NodeModules" mkdir "C:\ProgramCustom\LibCustom\NodeModules"
if not exist "%NM_PARENT%" mkdir "%NM_PARENT%"
if not exist "%NM_REAL%" mkdir "%NM_REAL%"

call :migrate_local_real_dir
if errorlevel 1 exit /b 1

call :remove_link_only

echo [INFO] npm install into entity dir (not via Junction)...
copy /Y "%FRONT%\package.json" "%NM_PARENT%\package.json" >nul
if exist "%FRONT%\package-lock.json" copy /Y "%FRONT%\package-lock.json" "%NM_PARENT%\package-lock.json" >nul

pushd "%NM_PARENT%"
call npm install
set "EC=%ERRORLEVEL%"
popd
if not "%EC%"=="0" exit /b %EC%

if exist "%NM_PARENT%\package-lock.json" copy /Y "%NM_PARENT%\package-lock.json" "%FRONT%\package-lock.json" >nul

call :ensure_junction
if errorlevel 1 exit /b 1

echo [OK] node_modules ready via Junction
endlocal
exit /b 0

:migrate_local_real_dir
if not exist "%NM_LINK%" exit /b 0
fsutil reparsepoint query "%NM_LINK%" >nul 2>&1
if not errorlevel 1 exit /b 0
echo [INFO] web\node_modules is a real directory; migrating to LibCustom...
robocopy "%NM_LINK%" "%NM_REAL%" /E /MOVE /NFL /NDL /NJH /NJS /nc /ns /np >nul
if errorlevel 8 (
  echo [ERROR] robocopy migrate failed
  exit /b 1
)
if exist "%NM_LINK%" rmdir /S /Q "%NM_LINK%" 2>nul
if exist "%NM_LINK%" (
  echo [ERROR] Could not remove local web\node_modules. Close programs using it and retry.
  exit /b 1
)
exit /b 0

:remove_link_only
if not exist "%NM_LINK%" exit /b 0
fsutil reparsepoint query "%NM_LINK%" >nul 2>&1
if errorlevel 1 exit /b 0
rmdir "%NM_LINK%"
exit /b 0

:ensure_junction
if exist "%NM_LINK%" (
  fsutil reparsepoint query "%NM_LINK%" >nul 2>&1
  if not errorlevel 1 (
    echo [OK] Junction present: web\node_modules
    exit /b 0
  )
  echo [ERROR] web\node_modules exists but is not a Junction
  exit /b 1
)
echo [INFO] Creating Junction...
mklink /J "%NM_LINK%" "%NM_REAL%"
if errorlevel 1 (
  echo [ERROR] mklink /J failed
  exit /b 1
)
exit /b 0
