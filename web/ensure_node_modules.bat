@echo off
chcp 65001 >nul
setlocal EnableExtensions

rem node_modules entity outside repo; web\node_modules and web_sstd\node_modules are Junctions.
rem Real: C:\ProgramCustom\LibCustom\NodeModules\user-center.web\node_modules
rem Links: <repo>\web\node_modules  and  <repo>\web_sstd\node_modules  -> that real directory
rem
rem Also ensures web\public\images\icon -> shared\public\images\icon Junction.
rem
rem Do NOT npm install against the Junction on Windows (npm reify may replace it).
rem Install in NM_PARENT with copied package.json/lock, then re-link.

set "FRONT=%~dp0"
if "%FRONT:~-1%"=="\" set "FRONT=%FRONT:~0,-1%"
set "REPO=%FRONT%\.."
for %%I in ("%REPO%") do set "REPO=%%~fI"

set "NM_PARENT=C:\ProgramCustom\LibCustom\NodeModules\user-center.web"
set "NM_REAL=%NM_PARENT%\node_modules"
set "NM_LINK=%FRONT%\node_modules"
set "NM_LINK_SSTD=%REPO%\web_sstd\node_modules"
set "ICON_LINK=%FRONT%\public\images\icon"
set "ICON_REAL=%REPO%\shared\public\images\icon"

echo === ensure_node_modules (user-center.web) ===
echo NM_REAL=%NM_REAL%
echo NM_LINK=%NM_LINK%
echo NM_LINK_SSTD=%NM_LINK_SSTD%

where npm >nul 2>&1
if errorlevel 1 (
  echo [ERROR] npm not found in PATH
  exit /b 1
)

if not exist "C:\ProgramCustom\LibCustom\NodeModules" mkdir "C:\ProgramCustom\LibCustom\NodeModules"
if not exist "%NM_PARENT%" mkdir "%NM_PARENT%"
if not exist "%NM_REAL%" mkdir "%NM_REAL%"

call :migrate_local_real_dir "%NM_LINK%"
if errorlevel 1 exit /b 1
call :migrate_local_real_dir "%NM_LINK_SSTD%"
if errorlevel 1 exit /b 1

call :remove_link_only "%NM_LINK%"
call :remove_link_only "%NM_LINK_SSTD%"

echo [INFO] npm install into entity dir (not via Junction)...
copy /Y "%FRONT%\package.json" "%NM_PARENT%\package.json" >nul
if exist "%FRONT%\package-lock.json" copy /Y "%FRONT%\package-lock.json" "%NM_PARENT%\package-lock.json" >nul

pushd "%NM_PARENT%"
call npm install
set "EC=%ERRORLEVEL%"
popd
if not "%EC%"=="0" exit /b %EC%

if exist "%NM_PARENT%\package-lock.json" copy /Y "%NM_PARENT%\package-lock.json" "%FRONT%\package-lock.json" >nul

call :ensure_junction "%NM_LINK%" "%NM_REAL%" "web\node_modules"
if errorlevel 1 exit /b 1

if exist "%REPO%\web_sstd\package.json" (
  call :ensure_junction "%NM_LINK_SSTD%" "%NM_REAL%" "web_sstd\node_modules"
  if errorlevel 1 exit /b 1
)

call :ensure_icon_junction
if errorlevel 1 exit /b 1

echo [OK] node_modules ready via Junction ^(web + web_sstd^)
endlocal
exit /b 0

:migrate_local_real_dir
set "LINK=%~1"
if not exist "%LINK%" exit /b 0
fsutil reparsepoint query "%LINK%" >nul 2>&1
if not errorlevel 1 exit /b 0
echo [INFO] %LINK% is a real directory; migrating to LibCustom...
robocopy "%LINK%" "%NM_REAL%" /E /MOVE /NFL /NDL /NJH /NJS /nc /ns /np >nul
if errorlevel 8 (
  echo [ERROR] robocopy migrate failed for %LINK%
  exit /b 1
)
if exist "%LINK%" rmdir /S /Q "%LINK%" 2>nul
if exist "%LINK%" (
  echo [ERROR] Could not remove %LINK%. Close programs using it and retry.
  exit /b 1
)
exit /b 0

:remove_link_only
set "LINK=%~1"
if not exist "%LINK%" exit /b 0
fsutil reparsepoint query "%LINK%" >nul 2>&1
if errorlevel 1 exit /b 0
rmdir "%LINK%"
exit /b 0

:ensure_junction
set "LINK=%~1"
set "REAL=%~2"
set "LABEL=%~3"
if exist "%LINK%" (
  fsutil reparsepoint query "%LINK%" >nul 2>&1
  if not errorlevel 1 (
    echo [OK] Junction present: %LABEL%
    exit /b 0
  )
  echo [ERROR] %LABEL% exists but is not a Junction
  exit /b 1
)
echo [INFO] Creating Junction %LABEL%...
mklink /J "%LINK%" "%REAL%"
if errorlevel 1 (
  echo [ERROR] mklink /J failed for %LABEL%
  exit /b 1
)
exit /b 0

:ensure_icon_junction
if not exist "%ICON_REAL%" (
  echo [WARN] shared\public\images\icon missing; skip icon Junction
  exit /b 0
)
if exist "%ICON_LINK%" (
  fsutil reparsepoint query "%ICON_LINK%" >nul 2>&1
  if not errorlevel 1 (
    echo [OK] Junction present: web\public\images\icon
    exit /b 0
  )
  echo [INFO] Replacing real web\public\images\icon with Junction...
  rmdir /S /Q "%ICON_LINK%" 2>nul
  if exist "%ICON_LINK%" (
    echo [ERROR] Could not remove web\public\images\icon
    exit /b 1
  )
)
if not exist "%FRONT%\public\images" mkdir "%FRONT%\public\images"
echo [INFO] Creating Junction web\public\images\icon...
mklink /J "%ICON_LINK%" "%ICON_REAL%"
if errorlevel 1 (
  echo [ERROR] mklink /J failed for icons
  exit /b 1
)
exit /b 0
