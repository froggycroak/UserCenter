# 复制为 .env 后按需修改（.env 勿提交真实联系邮箱到公开仓库时可改用 CI 注入）

# 1=纯静态（nginx :1088 演示）；0=本地对接 user-center 后端（需 Kestrel :1010）
VITE_STATIC_DEMO=1
# 开发时 Vite 将 /api 代理到 user-center Kestrel
VITE_DEV_API_TARGET=http://127.0.0.1:1010
VITE_BASE=/
VITE_SITE_TITLE=SSTD DIGITAL PORTAL
VITE_SITE_TAGLINE=华建集团中央研究院 · 数字化导航
VITE_SITE_FOOTER=© 2026 SSTD Digital
VITE_SUPPORT_NAME=数字化专班
VITE_SUPPORT_EMAIL=support@example.com
